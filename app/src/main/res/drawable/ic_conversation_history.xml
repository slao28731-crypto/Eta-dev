<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
      会话历史：两条圆头横线，上长下短。
      参数由用户在 demo/topbar-v2.html 调定：gap=9.0dp、上线 3.5→19.0、下线 3.5→12.3、线粗 2.4。
      strokeWidth 以 viewport 为单位，24dp 图标里 2.4 单位 ≈ 2.4dp，与预览一致。
    -->
    <path
        android:pathData="M3.5,7.5 L19,7.5"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
    <path
        android:pathData="M3.5,16.5 L12.3,16.5"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />
</vector>